# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# Generate a new SECRET_KEY for any real deployment:
#   .venv/Scripts/python.exe -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-generated-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. DB_ENGINE=sqlite (the development default) needs no other values.
# DB_ENGINE=postgresql switches to PostgreSQL and requires the psycopg package.
DB_ENGINE=sqlite
# DB_NAME=secure_sdlc
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# OWASP ZAP daemon. The API key is blank in dev because ZAP runs with the key disabled.
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# Scan safety. Comma-separated host allowlist; no scheme, no port, no path.
SCAN_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,juice-shop
SCAN_TIMEOUT_SECONDS=900
